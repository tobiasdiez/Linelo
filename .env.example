# Development settings, loaded by default (`pnpm dev`, `pnpm db:*`). Copy to .env.
# Production settings go to .env.production (see .env.production.example), which is only loaded on request.

# Leave empty to use the embedded PGlite database under .data/pglite.
DATABASE_URL=

# Signs sessions and encrypts the stored Microsoft tokens. Optional in development;
# generate one with `openssl rand -base64 32`.
BETTER_AUTH_SECRET=

# Sign-in with Microsoft: the Entra app registration (see README). Without them, use the demo mailbox.
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
