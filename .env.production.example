# Production settings. Copy to .env.production; it is never loaded by default.
# Use it with `pnpm build --dotenv .env.production`, `pnpm preview --dotenv .env.production`,
# `pnpm db:migrate:production` and `pnpm db:studio:production`.

# PostgreSQL connection string, for example Neon's pooled one
# (`neon env pull --file .env.production` fills these in).
DATABASE_URL=
# Optional: Neon's direct connection, used for migrations when set.
DATABASE_URL_UNPOOLED=

# Signs sessions and encrypts the stored Microsoft tokens. Required; generate one with
# `openssl rand -base64 32`, separate from development. Changing it signs everyone out and Linelo loses the stored tokens.
BETTER_AUTH_SECRET=
# The public origin of the app, such as https://linelo.example. Required.
BETTER_AUTH_URL=

# Sign-in with Microsoft: the Entra app registration (see README).
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
